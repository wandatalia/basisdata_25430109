\n        decimal harga_satuan_detail_penjualan \&quot;NOT NULL\&quot;\n    }\n\n    pembelian {\n        int id_pembelian PK \&quot;AI\&quot;\n        int id_pemasok FK \&quot;→ pemasok\&quot;\n        varchar no_faktur_pembelian \&quot;UNIQUE, NOT NULL\&quot;\n        date tgl_pembelian \&quot;NOT NULL\&quot;\n        enum status_pembelian \&quot;dipesan/diterima\&quot;\n    }\n\n    pemasok {\n        int id_pemasok PK \&quot;AI\&quot;\n        varchar nama_pemasok \&quot;NOT NULL\&quot;\n        varchar telepon_pemasok \&quot;NULL\&quot;\n        varchar alamat_pemasok \&quot;NULL\&quot;\n    }\n\n    detail_pembelian {\n        int id_detail_pembelian PK \&quot;AI\&quot;\n        int id_pembelian FK \&quot;→ pembelian\&quot;\n        int id_barang FK \&quot;→ barang\&quot;\n        int qty_detail_pembelian \&quot;CHECK &gt; 0\&quot;\n        decimal harga_beli_detail_pembelian \&quot;NOT NULL\&quot;\n    }\n\n    %% Relasi dan Kardinalitas Sistem Kopma\n    kategori_barang ||--o{ barang : \&quot;mengelompokkan\&quot;\n    anggota ||--o{ penjualan : \&quot;melakukan\&quot;\n    petugas ||--o{ penjualan : \&quot;melayani\&quot;\n    penjualan ||--|{ detail_penjualan : \&quot;memuat\&quot;\n    barang ||--o{ detail_penjualan : \&quot;tercatat_di\&quot;\n    pemasok ||--o{ pembelian : \&quot;menyuplai\&quot;\n    pembelian ||--|{ detail_pembelian : \&quot;berisi\&quot;\n    barang ||--o{ detail_pembelian : \&quot;dibeli_pada\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vx_v6FRL6QWDNiRCHkrp-1173">
